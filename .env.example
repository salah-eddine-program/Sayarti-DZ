# Browser: public Supabase project URL and anonymous key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server: use the same project as the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only secret. NEVER prefix this with VITE_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

PORT=3000
# Optional, only for the unused generic map component. Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
